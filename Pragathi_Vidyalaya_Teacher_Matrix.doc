<style>
  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #1e293b;
    margin: 40px;
    line-height: 1.5;
  }
  .header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 25px;
    border-bottom: 3px solid #4f46e5;
    padding-bottom: 15px;
  }
  .school-title {
    font-size: 24pt;
    font-weight: bold;
    color: #1e1b4b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .school-subtitle {
    font-size: 11pt;
    font-weight: bold;
    color: #d97706;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
  }
  .meta-info {
    font-size: 9.5pt;
    color: #64748b;
    margin-top: 6px;
  }
  h2 {
    font-size: 15pt;
    color: #312e81;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 6px;
    margin-top: 30px;
    margin-bottom: 12px;
  }
  table.matrix-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    margin-bottom: 25px;
    font-size: 10pt;
  }
  table.matrix-table th {
    background-color: #4f46e5;
    color: #ffffff;
    font-weight: bold;
    text-align: left;
    padding: 10px 12px;
    border: 1px solid #4338ca;
  }
  table.matrix-table td {
    padding: 9px 12px;
    border: 1px solid #cbd5e1;
  }
  table.matrix-table tr:nth-child(even) {
    background-color: #f8fafc;
  }
  .badge-admin {
    background-color: #dbeafe;
    color: #1e40af;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 9pt;
  }
  .badge-teacher {
    background-color: #fef3c7;
    color: #92400e;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 9pt;
  }
  .info-box {
    background-color: #f1f5f9;
    border-left: 4px solid #4f46e5;
    padding: 14px 18px;
    margin-top: 20px;
    border-radius: 4px;
    font-size: 10pt;
  }
  .info-box h3 {
    margin-top: 0;
    color: #1e1b4b;
    font-size: 11pt;
  }
  .footer {
    margin-top: 40px;
    padding-top: 15px;
    border-top: 1px solid #e2e8f0;
    font-size: 9pt;
    color: #94a3b8;
    text-align: center;
  }
</style>
</head>
